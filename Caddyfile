# ClawNet — Caddy reverse proxy config
# Deploy to /etc/caddy/Caddyfile on guardian-vps
#
# Static site:  /var/www/claw-net/ (clean URLs, no .html extensions)
# API:          localhost:3402 (Hono, Docker)
# Dashboard:    /var/www/claw-net-dashboard/ (Soma Signing Authority SPA)
# HeyVera app:  /home/guardian/www/heyvera/ (React SPA)

heyvera.org, www.heyvera.org {
	# Same-origin SPA API path coherence with api.heyvera.org:
	# Social + Pulse + health owned by heyvera-server :3002
	handle /v1/social/* {
		reverse_proxy localhost:3002 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /v1/pulse/* {
		reverse_proxy localhost:3002 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /v1/health {
		reverse_proxy localhost:3002 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /v1/ready {
		reverse_proxy localhost:3002 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /metrics {
		reverse_proxy localhost:3002 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Literal Socials-owned and duplicated API families. Cortex-only paths are
	# deliberately not reachable through the HeyVera origin.
	@heyvera_api path /api/health /api/billing/status /api/billing/checkout /api/billing/portal /api/billing/history /api/billing/usage /api/stripe/webhook /api/clerk/webhooks /api/admin/stats /api/admin/codes /api/admin/codes/* /api/admin/redemptions /api/admin/audit-log /api/admin/accounts/*/suspend /api/admin/accounts/*/unsuspend /api/admin/cleanup-orphaned-media /api/admin/reports
	handle @heyvera_api {
		reverse_proxy localhost:3002 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /api/* {
		respond "Not found" 404
	}

	handle /v1/* {
		respond "Not found" 404
	}

	handle /assets/* {
		root * /home/guardian/www/heyvera
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle {
		root * /home/guardian/www/heyvera
		try_files {path} /index.html
		file_server
		header Cache-Control "no-cache, no-store, must-revalidate"
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

cortex.heyvera.org {
	# API routes - MUST be first for priority
	@api path /api/* /v1/*
	handle @api {
		reverse_proxy localhost:3001 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Static assets with caching
	@assets path /assets/*
	handle @assets {
		root * /var/www/cortex
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# SPA fallback for all other requests
	handle {
		root * /var/www/cortex
		try_files {path} /index.html
		file_server
		header Cache-Control "no-cache, no-store, must-revalidate"
	}

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

api.heyvera.org {
	# Socials-owned and duplicated APIs stay on the Socials service.
	@heyvera_api path /api/health /api/billing/status /api/billing/checkout /api/billing/portal /api/billing/history /api/billing/usage /api/stripe/webhook /api/clerk/webhooks /api/admin/stats /api/admin/codes /api/admin/codes/* /api/admin/redemptions /api/admin/audit-log /api/admin/accounts/*/suspend /api/admin/accounts/*/unsuspend /api/admin/cleanup-orphaned-media /api/admin/reports
	handle @heyvera_api {
		reverse_proxy localhost:3002 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Cortex compatibility paths are explicit; no catch-all can leak a newly
	# added API into the wrong product.
	@cortex_api path /api/chat /api/chat/* /api/runs /api/runs/* /api/context/* /api/keys /api/keys/* /api/github/* /api/projects /api/projects/* /api/admin/workers /api/admin/decisions /api/admin/runs /api/admin/runs/* /api/admin/pressure /api/admin/usage /api/admin/usage/* /api/admin/reconcile-counters /api/admin/containers /api/admin/containers/* /api/auth/* /api/authority/* /api/billing/referral/validate /api/conversations /api/conversations/* /api/credentials/* /api/deploy-info /api/deploy-metadata /api/deploy-status /api/deployment/* /api/integrations/* /api/groups/* /api/ledger /api/mc /api/mc/* /api/operations/* /api/providers /api/usage /api/usage/* /api/user/* /api/ws
	handle @cortex_api {
		reverse_proxy localhost:3001 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /api/* {
		respond "Not found" 404
	}

	# HeyVera Social + Pulse + health — single owner: heyvera-server :3002
	handle /v1/social/* {
		reverse_proxy localhost:3002 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /v1/pulse/* {
		reverse_proxy localhost:3002 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /v1/health {
		reverse_proxy localhost:3002 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /v1/ready {
		reverse_proxy localhost:3002 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /metrics {
		reverse_proxy localhost:3002 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /v1/* {
		respond "Not found" 404
	}

	handle {
		respond "Not found" 404
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

api.claw-net.org {
	reverse_proxy localhost:3402
}

pulse.claw-net.org {
	reverse_proxy localhost:3457
}

radar.claw-net.org {
	reverse_proxy localhost:3459
}

claw-net.org, www.claw-net.org {
	# Static site — clean URLs
	root * /var/www/claw-net

	# Dashboard SPA — serve built Vite app as static files
	# All /dashboard/* paths serve from the dashboard dist dir
	# with SPA fallback (all sub-routes serve index.html)
	handle_path /dashboard/* {
		root * /var/www/claw-net-dashboard
		try_files {path} /index.html
		file_server
	}
	# Bare /dashboard redirects to /dashboard/
	redir /dashboard /dashboard/ 308

	# ADDITION: Proxy /api/* to API server so dashboard API
	# calls work from same origin (dashboard uses relative URLs
	# like /api/authn/register/options)
	handle /api/* {
		reverse_proxy localhost:3402
	}

	# Portal — also proxy to API (legacy path)
	route /portal* {
		reverse_proxy localhost:3402
	}

	# Clean URL rewrite: /endpoints → endpoints.html
	try_files {path} {path}.html {path}/index.html

	file_server

	# API reverse proxy — all /v1/*, /x402/*, /mcp/*, /health, etc.
	handle /v1/* {
		reverse_proxy localhost:3402
	}
	handle /x402/* {
		reverse_proxy localhost:3402
	}
	handle /mcp/* {
		reverse_proxy localhost:3402
	}
	handle /health {
		reverse_proxy localhost:3402
	}
	handle /.well-known/* {
		reverse_proxy localhost:3402
	}
	handle /a2a/* {
		reverse_proxy localhost:3402
	}
	handle /feed.xml {
		reverse_proxy localhost:3402
	}
	handle /health/* {
		reverse_proxy localhost:3402
	}
	handle /llms.txt {
		reverse_proxy localhost:3402
	}
	handle /llms.txt/* {
		reverse_proxy localhost:3402
	}

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
